{
  "name": "gittree",
  "displayName": "GitTree",
  "description": "IntelliJ-grade Git integration for VS Code: changelists, log graph, interactive rebase, 3-pane merge, shelve, code review, and local history.",
  "version": "0.0.1",
  "publisher": "gittree",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gittree/git-tree-vsix.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "scm",
    "changelists",
    "rebase",
    "merge"
  ],
  "main": "./dist/extension.js",
  "workspaces": [
    "webview-ui"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "%gittree.config.title%",
        "properties": {
          "gittree.gitPath": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "scope": "machine-overridable",
            "description": "%gittree.config.gitPath.description%"
          },
          "gittree.trace": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.trace.description%"
          },
          "gittree.mode": {
            "type": "string",
            "enum": [
              "auto",
              "takeover",
              "companion"
            ],
            "enumDescriptions": [
              "%gittree.config.mode.auto%",
              "%gittree.config.mode.takeover%",
              "%gittree.config.mode.companion%"
            ],
            "default": "auto",
            "scope": "window",
            "description": "%gittree.config.mode.description%"
          },
          "gittree.terminalAuth": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "description": "%gittree.config.terminalAuth.description%"
          }
        }
      },
      {
        "title": "%gittree.config.scm.title%",
        "properties": {
          "gittree.quickDiff.base": {
            "type": "string",
            "enum": [
              "index",
              "head"
            ],
            "default": "index",
            "description": "%gittree.config.quickDiff.base.description%"
          },
          "gittree.autofetch.enabled": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.autofetch.enabled.description%"
          },
          "gittree.autofetch.intervalSeconds": {
            "type": "number",
            "default": 180,
            "minimum": 30,
            "description": "%gittree.config.autofetch.intervalSeconds.description%"
          },
          "gittree.branches.recentCount": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "description": "%gittree.config.branches.recentCount.description%"
          },
          "gittree.branches.defaultAction": {
            "type": "string",
            "enum": [
              "checkout",
              "showActions"
            ],
            "default": "checkout",
            "description": "%gittree.config.branches.defaultAction.description%"
          },
          "gittree.smartCheckout.behavior": {
            "type": "string",
            "enum": [
              "ask",
              "auto",
              "never"
            ],
            "default": "ask",
            "description": "%gittree.config.smartCheckout.behavior.description%"
          },
          "gittree.cherryPick.recordOrigin": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.cherryPick.recordOrigin.description%"
          },
          "gittree.pushSafety.afterRewrite": {
            "type": "string",
            "enum": [
              "ask",
              "never"
            ],
            "default": "ask",
            "description": "%gittree.config.pushSafety.afterRewrite.description%"
          }
        }
      },
      {
        "title": "%gittree.config.commit.title%",
        "properties": {
          "gittree.commit.paradigm": {
            "type": "string",
            "enum": [
              "changelists",
              "staging"
            ],
            "default": "changelists",
            "scope": "window",
            "description": "%gittree.config.commit.paradigm.description%"
          },
          "gittree.commit.checks.reformat": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.commit.checks.reformat.description%"
          },
          "gittree.commit.checks.optimizeImports": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.commit.checks.optimizeImports.description%"
          },
          "gittree.commit.checks.cleanup": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.commit.checks.cleanup.description%"
          },
          "gittree.commit.checks.analyze": {
            "type": "boolean",
            "default": true,
            "description": "%gittree.config.commit.checks.analyze.description%"
          },
          "gittree.commit.checks.analyzeSeverity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "default": "error",
            "description": "%gittree.config.commit.checks.analyzeSeverity.description%"
          },
          "gittree.commit.checks.todo": {
            "type": "boolean",
            "default": true,
            "description": "%gittree.config.commit.checks.todo.description%"
          },
          "gittree.commit.checks.todoPattern": {
            "type": "string",
            "default": "\\b(TODO|FIXME)\\b",
            "description": "%gittree.config.commit.checks.todoPattern.description%"
          }
        }
      },
      {
        "title": "%gittree.config.log.title%",
        "properties": {
          "gittree.log.sort": {
            "type": "string",
            "enum": [
              "date",
              "topo",
              "intelli"
            ],
            "default": "topo",
            "description": "%gittree.config.log.sort.description%"
          },
          "gittree.blame.heatmap": {
            "type": "boolean",
            "default": true,
            "description": "%gittree.config.blame.heatmap.description%"
          },
          "gittree.blame.format": {
            "type": "string",
            "default": "${author|12} ${date|relative} ${sha|7}",
            "description": "%gittree.config.blame.format.description%"
          }
        }
      },
      {
        "title": "%gittree.config.localHistory.title%",
        "properties": {
          "gittree.localHistory.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%gittree.config.localHistory.enabled.description%"
          },
          "gittree.localHistory.maxSizeMb": {
            "type": "number",
            "default": 500,
            "minimum": 10,
            "description": "%gittree.config.localHistory.maxSizeMb.description%"
          },
          "gittree.localHistory.retentionDays": {
            "type": "number",
            "default": 30,
            "minimum": 1,
            "description": "%gittree.config.localHistory.retentionDays.description%"
          },
          "gittree.localHistory.maxFileSizeKb": {
            "type": "number",
            "default": 1024,
            "minimum": 1,
            "description": "%gittree.config.localHistory.maxFileSizeKb.description%"
          },
          "gittree.localHistory.snapshotOnSave": {
            "type": "boolean",
            "default": false,
            "description": "%gittree.config.localHistory.snapshotOnSave.description%"
          },
          "gittree.localHistory.taskLabels": {
            "type": "boolean",
            "default": true,
            "description": "%gittree.config.localHistory.taskLabels.description%"
          }
        }
      }
    ],
