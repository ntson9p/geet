        {
          "id": "gittree.localHistory",
          "name": "%gittree.view.localHistory.name%",
          "contextualTitle": "GitTree",
          "icon": "$(history)",
          "visibility": "collapsed"
        },
        {
          "id": "gittree.conflicts",
          "name": "%gittree.view.conflicts.name%",
          "contextualTitle": "GitTree",
          "icon": "$(git-merge)",
          "when": "gittree.hasConflicts"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gittree-panel",
          "title": "%gittree.panel.title%",
          "icon": "$(git-branch)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run build:webviews",
    "build": "node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build:webviews": "npm run build -w webview-ui",
    "typecheck": "tsc --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:webview": "npm run test -w webview-ui",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "pretest:integration": "node esbuild.mjs && npm run build:webviews && tsc -p tsconfig.integration.json",
    "test:integration": "node ./out/test/integration/runTests.js",
    "package": "vsce package --pre-release"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
